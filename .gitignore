# Sorties generees par la simulation (les exports ne sont pas versionnes)
/outputs/**
!/outputs/.gitkeep

# Pickles / archives intermediaires
*.pkl
*.pickle

# Donnees d'entree : seuls les fichiers necessaires au fonctionnement sont versionnes
# (inputs/parameters : parametrage du modele ; inputs/reference : grilles de reference des tests).
# Tout autre contenu de inputs/ (jeux de donnees volumineux, documentation interne) est ignore.
/inputs/*
!/inputs/parameters/
!/inputs/reference/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environnements virtuels
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
